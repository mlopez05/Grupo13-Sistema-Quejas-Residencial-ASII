# COPIAR ESTE ARCHIVO COMO .env Y COMPLETAR LOS VALORES. EL .env NUNCA SE SUBE AL REPOSITORIO.
# AQUÍ SOLO VAN VALORES DE EJEMPLO: ESTE ARCHIVO SÍ SE SUBE A GITHUB.
# LO USAN DOCKER COMPOSE, VS CODE (envFile) Y LOS SERVICIOS AL EJECUTARSE CON mvn spring-boot:run.

# DIRECCIÓN PÚBLICA DEL PORTAL (SE USA EN LOS ENLACES DE LOS CORREOS) Y PUERTO DEL FRONT
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200

# CLAVE PARA FIRMAR LOS TOKENS (LA MISMA PARA TODOS LOS SERVICIOS, MÍNIMO 32 CARACTERES)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_de_64_caracteres

# PRIMER ADMINISTRADOR (SOLO SE CREA SI LA BASE NO TIENE NINGUNO; LA CLAVE ES TEMPORAL)
ADMIN_CORREO=admin@residencial.com
ADMIN_CLAVE=cambia_esta_clave

# CONTRASEÑAS DE LAS BASES DE DATOS (UNA POR MICROSERVICIO)
DB_AUTH_PASSWORD=cambia_esta_clave
DB_CASOS_PASSWORD=cambia_esta_clave
DB_CONTENIDO_PASSWORD=cambia_esta_clave
DB_NOTIFICACIONES_PASSWORD=cambia_esta_clave
DB_BITACORA_PASSWORD=cambia_esta_clave

# CORREO: "smtp" (GMAIL, SOLO FUNCIONA EN LOCAL) O "brevo" (API HTTPS, PARA LA NUBE)
CORREO_PROVEEDOR=smtp
# DIRECCIÓN QUE APARECE COMO REMITENTE (EN BREVO DEBE ESTAR VERIFICADA)
CORREO_REMITENTE=correo@dominio.com

# SMTP (GMAIL): CORREO Y CLAVE DE APLICACIÓN (SIN ESPACIOS)
MAIL_USERNAME=correo@gmail.com
MAIL_PASSWORD=clave_de_aplicacion

# BREVO: CLAVE DE API (Brevo > SMTP & API > API Keys)
BREVO_API_KEY=
